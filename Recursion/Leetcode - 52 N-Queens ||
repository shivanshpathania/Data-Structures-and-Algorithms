class Solution {
    public boolean isSafe(int row,int col,char [][] nQueens,int n){
        int currRow = row;
        int currCol = col;

        // check first for the row 
        while(col>=0){
            if(nQueens[row][col] == 'Q')return false;
            col--;
        }
        // now check for the upper diagonal
        row = currRow;
        col = currCol;
        while(row>=0 && col>=0){
            if(nQueens[row][col] == 'Q')return false;
            row--;
            col--;
        }
        // check for the lower diagonal
        row = currRow;
        col = currCol;
        while(row < n && col >= 0){
            if(nQueens[row][col] == 'Q')return false;
            row++;
            col--;
        }
        return true;
    }
    public void solveNQueens(int col,int n,List<List<String>> output,char [][] nQueens){
        if(col == n){
            List<String> temp = new ArrayList<>();
            for(char [] ch : nQueens){
                temp.add(new String(ch));
            }
            output.add(new ArrayList<>(temp));
            return;
        }

        for(int row = 0;row<n;row++){
            if(isSafe(row,col,nQueens,n)){
                nQueens[row][col] = 'Q';
                solveNQueens(col+1,n,output,nQueens);
                nQueens[row][col] = '.';
            }
        }

    }
    public int totalNQueens(int n) {
        List<List<String>> output = new ArrayList<>();
        char [][] nQueens = new char [n][n];
        for(char [] row : nQueens){
            Arrays.fill(row,'.');
        }
        solveNQueens(0,n,output,nQueens);
        return output.size();
    }
}
