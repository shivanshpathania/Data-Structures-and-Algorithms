// dfs

class Solution {
    public void dfs(int row,int col,int originalColor,int newColor,int [][] resultImage,int [] delRow,int []delCol){
        resultImage[row][col] = newColor;
        int n = resultImage.length;
        int m = resultImage[0].length;
        for(int i = 0;i<4;i++){
            int nrow = row + delRow[i];
            int ncol = col + delCol[i];
            if(nrow >= 0 && nrow < n && ncol >=0 && ncol < m && resultImage[nrow][ncol] == originalColor){
                dfs(nrow,ncol,originalColor,newColor,resultImage,delRow,delCol);
            }
        }
        
    }
    public int[][] floodFill(int[][] image, int sr, int sc, int newColor) {
        int originalColor = image[sr][sc];
        int [][] resultImage = image;
        
        if(originalColor == newColor)return image;
        
        // directions
        int [] delRow = {-1,0,1,0};
        int [] delCol = {0,1,0,-1};
        dfs(sr,sc,originalColor,newColor,resultImage,delRow,delCol);
        return resultImage;
    }
}
