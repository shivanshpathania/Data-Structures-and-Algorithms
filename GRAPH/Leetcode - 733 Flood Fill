// dfs

class Solution {
    public void dfs(int row,int col,int [] delRow,int [] delCol,int newcolor,int [][] image,int [][] resultImage,int strtColor){
        resultImage[row][col] = newcolor;
        int n = image.length;
        int m = image[0].length;
        for(int i = 0;i<4;i++){
            int nrow = row + delRow[i];
            int ncol = col + delCol[i];
            if((nrow < n && nrow >= 0 && ncol >= 0 && ncol < m) &&
            image[nrow][ncol] == strtColor && resultImage[nrow][ncol]!=newcolor){

                dfs(nrow,ncol,delRow,delCol,newcolor,image,resultImage,strtColor);
                
            }
        }
    }
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int strtColor = image[sr][sc];
        int [][] resultImage = image;
        int [] delRow = {-1,0,1,0};
        int [] delCol = {0,1,0,-1};
        dfs(sr,sc,delRow,delCol,color,image,resultImage,strtColor);
        return resultImage;
    }
}
