class Solution {
    public boolean bfs(int start ,int [] color,int [][] graph){
        color[start] = 0;
        Queue<Integer> q = new LinkedList<>();
        q.offer(start);
        // checking in the adj matrix
        while(!q.isEmpty()){
            int node = q.peek();
            q.remove();
            for(int ele : graph[node]){
                if(color[ele] == -1){
                    color[ele] = 1 - color[node];
                    q.offer(ele);
                }
                else if(color[ele] == color[node]){
                    return false;
                }
            }
        }
        return true;
    }
    public boolean dfs(int start,int clr,int [] color,int [][] graph){
        color[start] = clr;

        for(int ele : graph[start]){
            if(color[ele] == -1){
                if(!dfs(ele,1-clr,color,graph))return false;
            }
            else if(color[ele] == clr)return false;
        }
        return true;
    }
    public boolean isBipartite(int[][] graph) {
        int n = graph.length;

        int [] color = new int[n];
        Arrays.fill(color,-1);
        // coloring the graph with 0 and 1

        // now checking for all the components

        for(int i = 0;i<n;i++){
            // if( color[i] == -1 &&(bfs(i,color,graph) == false))return false;
            if( color[i] == -1 &&(dfs(i,0,color,graph) == false))return false;
        }
        return true;
    }
}
