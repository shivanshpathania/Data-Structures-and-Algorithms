// dfs solution 

class Solution {
    public void dfs(int node,int v,boolean [] visited,ArrayList<ArrayList<Integer>> adj){
        visited[node] = true;
        for(int ele : adj.get(node)){
            if(!visited[ele]){
                dfs(ele,v,visited,adj);
            }
        }
    }
    public int findCircleNum(int[][] isConnected) {
        int n = isConnected.length;

        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for(int i = 0;i<n;i++) adj.add(new ArrayList<>());

        // converting the adj matrix to adj list

        for(int i = 0;i<n;i++){
            for(int j = 0;j<n;j++){
                if(i != j && isConnected[i][j] == 1){
                    adj.get(i).add(j);
                    adj.get(j).add(i);
                }
            }
        }

        // main dfs

        boolean [] visited = new boolean[n];
        int count = 0;
        for(int i = 0;i<n;i++){
            if(!visited[i]){
                count++;
                dfs(i,n,visited,adj);
            }
        }
        return count;
    }
}
