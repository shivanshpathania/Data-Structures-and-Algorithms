class Solution {
    public int climb(int [] dp,int n){
        if(n<=2)return n;
        if(dp[n] != -1)return dp[n];
        return dp[n] = climb(dp,n-1) + climb(dp,n-2);
    }
    public int climbStairs(int n) {
        int [] dp = new int[n+1];
        Arrays.fill(dp,-1);
        int ans = climb(dp,n);
        return ans;
    }
}
