 // Recusrion + Memo

class Solution {
    public int f(int i,int j,int n,int m,char [][] arr,int [][] dp){
        if(i >= n || j >= m || arr[i][j] == '0')return 0;
        if(dp[i][j]!=-1)return dp[i][j];
        int right = f(i,j+1,n,m,arr,dp);
        int left = f(i+1,j,n,m,arr,dp);
        int diag = f(i+1,j+1,n,m,arr,dp);
        return dp[i][j] =  1 + Math.min(diag,Math.min(left,right));
    }
    public int maximalSquare(char[][] matrix) {
        int n = matrix.length;
        int m = matrix[0].length;
        int [][] dp = new int[n][m];
        for (int[] row : dp) Arrays.fill(row, -1);
        int ans = Integer.MIN_VALUE;
        for(int i = 0;i<n;i++){
            for(int j = 0;j<m;j++){
                if(matrix[i][j] == '1'){
                    ans = Math.max(ans,f(i,j,n,m,matrix,dp));
                }
            }
        }
        return ans * ans;
    }
}
