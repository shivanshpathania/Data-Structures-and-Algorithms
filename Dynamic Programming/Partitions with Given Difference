
class Solution {
    public int f(int idx ,int target,int [] arr,int [][]dp){
        if(idx == 0){
            if(target == 0 && arr[0] == 0)return 2;
            if(target == 0 || arr[0] == target)return 1;
            return 0;
        }
        if(dp[idx][target]!=-1)return dp[idx][target];
        int notPick = f(idx-1,target,arr,dp);
        int pick = 0;
        if(arr[idx] <= target)pick = f(idx-1,target-arr[idx],arr,dp);
        return dp[idx][target] = notPick + pick;
    }
    int countPartitions(int[] arr, int d) {
        // so we here convert the peoblem into count 
        // subsets sum with sum equal t0 k 
        
        // so the ques is s1 >= s2 and s1 - s2 == d
        // we can write as s1 = totalSum - s2 that is s1
        // so totalSum - s2 - s2 = d;
        // 2s2 = totalSum - d;
        // s2 = totalSum - d / 2
        // so this is we need to calc
        // as totalSUm - d > 0 and totalSum - d should be even
        
        int n = arr.length;
        int totalSum = 0;
        for(int ele : arr)totalSum+=ele;
        int target = (totalSum - d) / 2;
        if(totalSum - d < 0 || (totalSum - d) % 2 == 1)return 0;
        
        int [][] dp = new int[n][target+1];
        for(int [] row : dp)Arrays.fill(row,-1);
        return f(n-1,target,arr,dp);
    }
}
